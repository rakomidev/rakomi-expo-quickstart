# Expo inlines EXPO_PUBLIC_* vars into the bundle at build time (they are NOT secret — a
# publishable OAuth client_id, not an API key). Copy this file to `.env.local` and fill in.

EXPO_PUBLIC_RAKOMI_CLIENT_ID=your-oauth-client-id
EXPO_PUBLIC_RAKOMI_BASE_URL=https://api.rakomi.com

# Optional biometric-unlock path — off by default. When "true", a signed-in session's stored
# refresh token can only be read after the device screen lock (Face ID / Touch ID / fingerprint
# / passcode) succeeds — see README "Biometric unlock".
EXPO_PUBLIC_BIOMETRIC_UNLOCK=false
